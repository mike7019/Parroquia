# ==============================================
# PARROQUIA API - ENVIRONMENT VARIABLES
# ==============================================

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=parroquia_db
DB_USER=parroquia_user
DB_PASSWORD=your_secure_password_here

# Server Configuration
# PORT es el puerto interno en el que escucha la app (PM2/ecosystem.config.cjs
# y docker-compose.yml lo fijan en 3000 — no lo cambies salvo que también
# actualices esos archivos). API_PORT es el puerto del HOST que docker-compose
# mapea hacia el 3000 interno del contenedor (ej. 3001 en el servidor remoto).
NODE_ENV=development
PORT=3000
API_PORT=3000

# JWT Authentication
JWT_SECRET=your_jwt_secret_minimum_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters_long
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=noreply@parroquia.com
# En development, con SEND_REAL_EMAILS distinto de 'true' los correos se
# simulan (no se envían) en vez de fallar si el SMTP no está configurado.
SEND_REAL_EMAILS=false

# Frontend URL
FRONTEND_URL=http://localhost:3001

# CORS Configuration
CORS_ORIGIN=*

# Logging (activa el log de cada query SQL ejecutada por Sequelize)
VERBOSE_LOGGING=false

# HTTPS local opcional (usado por `npm run dev:https`)
USE_HTTPS=false
HTTPS_PORT=3443

# PM2 Monitoring (Optional)
PM2_PUBLIC_KEY=
PM2_SECRET_KEY=

# ==============================================
# DOCKER CONFIGURATION
# ==============================================
# Al correr en Docker, DB_HOST debe ser el nombre del servicio de
# docker-compose ("postgres"), no localhost. docker-compose.yml ya fija esto
# automáticamente para el contenedor "api"; este DB_HOST solo aplica cuando
# corres la app directamente en tu máquina (npm run dev).
